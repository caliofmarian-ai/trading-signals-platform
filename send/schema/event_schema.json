{
  "schema_version": "2.0.0",
  "common_correlation_fields": {
    "signal_id": { "type": "string" },
    "symbol": { "type": "string" },
    "timeframe": { "type": "string" },
    "candle_ts_utc": { "type": "string" },
    "candle_ts_epoch": { "type": "integer" },
    "route": { "type": "string" },
    "tier": { "type": "string" },
    "destination_id": { "type": ["integer", "string"] },
    "stage": { "type": "string" },
    "user_id": { "type": ["integer", "string"] },
    "admin_actor_id": { "type": ["integer", "string"] },
    "message_id": { "type": "integer" },
    "thread_id": { "type": "integer" },
    "trace_id": { "type": "string" }
  },
  "envelope": {
    "required": {
      "event_id": { "type": "string" },
      "schema_version": { "type": "string", "enum": ["2.0.0"] },
      "ts_utc": { "type": "string" },
      "ts_epoch_ms": { "type": "integer" },
      "service": { "type": "string" },
      "env": { "type": "string" },
      "run_id": { "type": "string" },
      "source": { "type": "object" },
      "host": { "type": "object" }
    },
    "optional": {}
  },
  "source": {
    "required": {
      "module": { "type": "string" },
      "function": { "type": "string" }
    },
    "optional": {
      "line": { "type": "integer" }
    }
  },
  "host": {
    "required": {
      "hostname": { "type": "string" },
      "pid": { "type": "integer" },
      "app_version": { "type": "string" }
    },
    "optional": {
      "git_sha": { "type": "string" }
    }
  },
  "event_types": {
    "engine_start": {
      "sink": "engine",
      "data": {
        "required": {
          "message": { "type": "string" }
        },
        "optional": {}
      }
    },
    "engine_stop": {
      "sink": "engine",
      "data": {
        "required": {
          "message": { "type": "string" }
        },
        "optional": {}
      }
    },
    "signal_event": {
      "sink": "engine",
      "top_level_required": {
        "signal_id": { "type": "string" },
        "symbol": { "type": "string" },
        "timeframe": { "type": "string" },
        "stage": { "type": "string" }
      },
      "data": {
        "required": {
          "direction": { "type": "string" },
          "score_total": { "type": "number" },
          "buffer_mode": { "type": "string" },
          "buffer_price": { "type": "number" },
          "expiry_minutes": { "type": "integer" },
          "candle_ts": { "type": "integer" },
          "created_ts": { "type": "integer" }
        },
        "optional": {
          "payload": { "type": "object" },
          "TPS": { "type": ["number", "null"] },
          "space_to_buffer_ratio": { "type": ["number", "null"] },
          "trade_space_margin_atr": { "type": ["number", "null"] },
          "time_to_buffer_ratio": { "type": ["number", "null"] },
          "directional_speed_ratio": { "type": ["number", "null"] },
          "movement_stress": { "type": ["number", "null"] }
        }
      }
    },
    "decision": {
      "sink": "engine",
      "top_level_optional": {
        "signal_id": { "type": "string" },
        "symbol": { "type": "string" },
        "timeframe": { "type": "string" }
      },
      "data": {
        "required": {
          "decision_kind": { "type": "string" }
        },
        "optional": {
          "symbol": { "type": "string" },
          "signal_id": { "type": "string" },
          "score_total": { "type": "number" },
          "buffer_mode": { "type": "string" },
          "expiry_minutes": { "type": "integer" },
          "candle_ts": { "type": "integer" },
          "gates": { "type": "object" },
          "debug": { "type": "object" },
          "threshold_pre": { "type": ["number", "null"] },
          "threshold_confirm": { "type": ["number", "null"] },
          "threshold_open": { "type": ["number", "null"] },
          "threshold_source": { "type": ["string", "null"] },
          "threshold_config_error": { "type": ["string", "null"] },
          "telemetry_register_status": { "type": ["string", "null"] }
        }
      }
    },
    "fsm_transition": {
      "sink": "fsm",
      "data": {
        "required": {
          "symbol": { "type": "string" },
          "prev_state": { "type": "string" },
          "new_state": { "type": "string" },
          "trigger": { "type": "string" },
          "signal_id": { "type": "string" },
          "candle_ts": { "type": "integer" }
        },
        "optional": {}
      }
    },
    "tier_publish": {
      "sink": "distribution",
      "top_level_required": {
        "signal_id": { "type": "string" },
        "route": { "type": "string" },
        "tier": { "type": "string" },
        "stage": { "type": "string" }
      },
      "top_level_optional": {
        "symbol": { "type": "string" },
        "timeframe": { "type": "string" },
        "destination_id": { "type": ["integer", "string"] },
        "thread_id": { "type": "integer" },
        "message_id": { "type": "integer" },
        "candle_ts_epoch": { "type": "integer" }
      },
      "data": {
        "required": {
          "publish_result": {
            "type": "string",
            "enum": [
              "PUBLISHED",
              "SKIPPED_SILENT",
              "SKIPPED_LIMIT",
              "SKIPPED_DISABLED",
              "FAILED",
              "DUPLICATE_SUPPRESSED"
            ]
          },
          "route_state_before": { "type": "string" },
          "route_state_after": { "type": "string" },
          "limit": { "type": ["integer", "null"] },
          "counter_before": { "type": "integer" },
          "counter_after": { "type": "integer" },
          "counted": { "type": "boolean" },
          "attempted": { "type": "boolean" },
          "destination_kind": { "type": "string" },
          "feedback_enabled": { "type": "boolean" },
          "transport": {
            "type": "object",
            "required": {
              "ok": { "type": "boolean" },
              "message_id": { "type": ["integer", "null"] },
              "error": { "type": ["string", "null"] }
            },
            "optional": {}
          },
          "dedup": {
            "type": "object",
            "required": {
              "key": { "type": "string" },
              "was_duplicate": { "type": "boolean" },
              "action": { "type": "string" }
            },
            "optional": {}
          }
        },
        "optional": {
          "reason": { "type": ["string", "null"] }
        }
      }
    },
    "tier_reset": {
      "sink": "distribution",
      "data": {
        "required": {
          "reset_time_london": { "type": "string" },
          "effective_date_london": { "type": "string" },
          "before": {
            "type": "object",
            "required": {
              "tier_state": { "type": "object" },
              "open_signals_today": { "type": "object" },
              "last_reset_london_date": { "type": ["string", "null"] }
            },
            "optional": {}
          },
          "after": {
            "type": "object",
            "required": {
              "tier_state": { "type": "object" },
              "open_signals_today": { "type": "object" },
              "last_reset_london_date": { "type": ["string", "null"] }
            },
            "optional": {}
          }
        },
        "optional": {}
      }
    },
    "admin_change": {
      "sink": "admin_proofs",
      "data": {
        "required": {
          "kind": { "type": "string" },
          "payload": { "type": "object" },
          "now_ts_epoch": { "type": "integer" }
        },
        "optional": {}
      }
    },
    "user_outcome": {
      "sink": "outcomes",
      "top_level_required": {
        "signal_id": { "type": "string" },
        "tier": { "type": "string" },
        "user_id": { "type": ["integer", "string"] }
      },
      "data": {
        "required": {
          "outcome": {
            "type": "string",
            "enum": ["WIN", "LOSE", "MISSED"]
          },
          "policy": { "type": "string" },
          "accepted": { "type": "boolean" },
          "rejected_reason": { "type": ["string", "null"] }
        },
        "optional": {
          "vote_window": { "type": "object" }
        }
      }
    },
    "warning": {
      "sink": "error",
      "data": {
        "required": {
          "severity": { "type": "string", "enum": ["WARNING"] },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "context": { "type": "object" }
        },
        "optional": {}
      }
    },
    "error": {
      "sink": "error",
      "data": {
        "required": {
          "severity": { "type": "string" },
          "error_type": { "type": "string" },
          "message": { "type": "string" }
        },
        "optional": {
          "stack": { "type": ["string", "null"] },
          "context": { "type": "object" }
        }
      }
    },
    "OUTCOME_SET": {
      "sink": "outcomes",
      "data": {
        "required": {
          "signal_id": { "type": "string" },
          "outcome": { "type": "string" },
          "previous_outcome": { "type": ["string", "null"] },
          "user_id": { "type": ["integer", "null"] },
          "symbol": { "type": ["string", "null"] },
          "tier": { "type": "string" }
        },
        "optional": {}
      }
    },
    "outcome_panel_enabled": {
      "sink": "outcomes",
      "top_level_required": {
        "signal_id": { "type": "string" },
        "tier": { "type": "string" }
      },
      "data": {
        "required": {
          "elite_chat_id": { "type": "integer" },
          "open_message_id": { "type": "integer" },
          "open_now_ts": { "type": "integer" },
          "expiry_minutes": { "type": "integer" },
          "activation_ts": { "type": "integer" },
          "vote_end_ts": { "type": "integer" }
        },
        "optional": {}
      }
    },
    "system_health": {
      "sink": "engine",
      "data": {
        "required": {
          "message": { "type": "string" },
          "restart_count": { "type": "integer" },
          "window_seconds": { "type": "integer" },
          "max_restarts": { "type": "integer" }
        },
        "optional": {}
      }
    },
    "recovery_started": {
      "sink": "engine",
      "data": {
        "required": {
          "message": { "type": "string" },
          "restart_count": { "type": "integer" },
          "window_seconds": { "type": "integer" },
          "max_restarts": { "type": "integer" },
          "previous_shutdown_kind": { "type": "string" },
          "recovery_required": { "type": "boolean" }
        },
        "optional": {}
      }
    },
    "recovery_completed": {
      "sink": "engine",
      "data": {
        "required": {
          "message": { "type": "string" },
          "result": { "type": "string" },
          "blocked": { "type": "boolean" }
        },
        "optional": {
          "restart_count": { "type": "integer" },
          "blocked_operations": { "type": "array" }
        }
      }
    },
    "strategy_optimizer": {
      "sink": "engine",
      "data": {
        "required": {
          "suggestions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "win_rate": { "type": "number" }
        },
        "optional": {}
      }
    }
  }
}
