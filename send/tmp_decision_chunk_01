    "decision",
    "fsm_transition",
    "tier_publish",
    "tier_reset",
    "admin_change",
    "user_outcome",
    "error",
}


def _validate_minimal(event: Dict[str, Any]) -> None:
    # Minimal hard gate: envelope + type
    if "event_type" not in event:
        raise ValueError("event missing event_type")
    if event["event_type"] not in _ALLOWED_EVENT_TYPES:
        raise ValueError(f"invalid event_type: {event['event_type']}")
    for k in ("event_id", "schema_version", "ts_utc", "ts_epoch_ms", "service", "env", "run_id", "host"):
        if k not in event:
            raise ValueError(f"event missing required field: {k}")
    if "data" not in event:
        raise ValueError("event missing data")


def _route_file(event_type: str) -> str:
    if event_type in ("engine_start", "engine_stop", "decision", "signal_event"):
        return ENGINE_LOG
    if event_type == "fsm_transition":
        return FSM_LOG
    if event_type in ("tier_publish", "tier_reset"):
        return DIST_LOG
    if event_type == "admin_change":
        return ADMIN_PROOFS_LOG
    if event_type in ("user_outcome",):
        # outcomes live elsewhere in spec, but we keep it simple here.
        return os.path.join("/opt/binarybot/outcomes", "outcomes.jsonl")
    if event_type in ("error",):
        return ERROR_LOG
    return ERROR_LOG


def log_event(event: Dict[str, Any]) -> None:
    """
    Writes any canonical event to the correct JSONL file.
    If logging fails, fail-open (do not crash engine).
    """
    try:
        _validate_minimal(event)
        path = _route_file(str(event["event_type"]))
        _append_jsonl(path, event)
    except Exception:
        # fail-open: best effort error log
        try:
            err = build_error(
                severity="ERROR",
                error_type="observability_log_failed",
                message="Failed to write event log",
                context={"original_event_type": event.get("event_type")},
                stack=traceback.format_exc(),
                source={"module": "observability_logger", "function": "log_event"},
            )
            _append_jsonl(ERROR_LOG, err)
        except Exception:
            pass


def build_event(
    event_type: str,
    data: Dict[str, Any],
    *,
    source: Optional[Dict[str, Any]] = None,
    correlation: Optional[Dict[str, Any]] = None,
    **kwargs,
) -> Dict[str, Any]:
    e = _base_envelope(source=source)
    e["event_type"] = event_type
    if correlation:
        # allow only known correlation keys (soft)
        for k, v in correlation.items():
            if v is not None:
                e[k] = v
    e["data"] = data
    return e


def build_error(
    *,
    severity: str,
    error_type: str,
    message: str,
    context: Optional[Dict[str, Any]] = None,
    stack: Optional[str] = None,
    source: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
    data: Dict[str, Any] = {
        "severity": severity,
        "error_type": error_type,
        "message": message,
    }
    if stack:
        data["stack"] = stack
    if context:
        data["context"] = context
    return build_event("error", data, source=source)


def log_error(error: Dict[str, Any]) -> None:
    # convenience wrapper
    if error.get("event_type") != "error":
        # normalize if caller passes only data
        error = build_error(
            severity="ERROR",
            error_type=str(error.get("error_type", "error")),
            message=str(error.get("message", "error")),
            context=error.get("context"),
            stack=error.get("stack"),
            source=error.get("source"),
        )
    log_event(error)


