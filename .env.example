# REQUIRED FOR BOOT
BINARYBOT_BASE_DIR=/data
SHADOW_MODE=true
ENABLE_BROKER_EXECUTION=false
ENABLE_TELEGRAM=false

# REQUIRED FOR TELEGRAM MODE
TELEGRAM_BOT_TOKEN=replace-me
FREE_CHANNEL_ID=replace-me
BASIC_CHANNEL_ID=replace-me
PRO_CHANNEL_ID=replace-me
ELITE_CHANNEL_ID=replace-me
ADMIN_SUPERGROUP_ID=replace-me
ADMIN_GROUP_ID=replace-me
SIGNALS_LIVE_TOPIC_ID=replace-me
COMMUNITY_FEEDBACK_SALT=replace-me-with-32-plus-random-chars

# REQUIRED FOR MARKET DATA
# MARKET_DATA_PROVIDER is deployment bootstrap only when no persisted Owner
# provider selection exists under BINARYBOT_BASE_DIR. Persisted Owner selection
# wins. Existing invalid persisted provider state fails closed; it never falls
# back to this environment value. Exactly one provider is active at a time.
# Current governed shadow deployment bootstrap: FINNHUB, EUR/USD only.
MARKET_DATA_PROVIDER=FINNHUB
FINNHUB_API_KEY=replace-me
FINNHUB_CANDLE_STORE=/data/market_data/finnhub_eurusd.json
FINNHUB_MIN_CANDLES=201
MARKET_DATA_FRESHNESS_SECONDS=10

# TWELVE_DATA — alternative exclusive provider only when explicitly selected.
# Do not combine Finnhub and Twelve Data in one evidence stream.
TWELVE_DATA_API_KEY=replace-me

# REVOLUT MERCHANT BILLING — OPTIONAL / FAIL-CLOSED UNTIL PROVISIONED
# Sandbox is the safe default. Production calls additionally require
# REVOLUT_MERCHANT_ALLOW_PRODUCTION=true and production credentials.
# Never commit real keys or webhook secrets.
REVOLUT_MERCHANT_ENV=sandbox
REVOLUT_MERCHANT_API_VERSION=2026-04-20
REVOLUT_MERCHANT_SECRET_KEY=
REVOLUT_MERCHANT_WEBHOOK_SECRET=
REVOLUT_MERCHANT_ALLOW_PRODUCTION=false
REVOLUT_MERCHANT_MAX_RETRIES=2

# KUCOIN BILLING OBSERVER — OPTIONAL / READ-ONLY / FAIL-CLOSED UNTIL PROVISIONED
# Set the site to match the actual KuCoin account: global -> api.kucoin.com,
# eu -> api.kucoin.eu. Do not infer site/account jurisdiction from deployment location.
# Current adapter owns Classic Account observation only; UTA remains fail-closed.
# Live provider reads remain disabled until explicitly enabled after credentials are provisioned.
# Never commit real API key/secret/passphrase values.
KUCOIN_SITE=global
KUCOIN_ACCOUNT_MODE=classic
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
KUCOIN_API_KEY_VERSION=
KUCOIN_ALLOW_LIVE_READS=false
KUCOIN_MAX_RETRIES=2

# OPTIONAL
SERVICE_NAME=binarybot-shadow
BOT_ENV=railway-shadow
BOT_VERSION=replace-me
GIT_SHA=replace-me
OWNER_TELEGRAM_ID=replace-me
ADMIN_CONTROL_CHAT_ID=replace-me
ADMIN_CONTROL_THREAD_ID=0
ALGO_PARAMS_PATH=/data/config/algo_params.json
ADMIN_ROLES_CONFIG=/data/config/admin_roles.json
ADMIN_PERMISSIONS_CONFIG=/data/config/admin_permissions.json
OBS_DIR=/data/observability
OUTCOMES_LOG=/data/outcomes/outcomes.jsonl
ANALYTICS_DIR=/data/analytics
DIST_EVENTS_LOG=/data/observability/distribution_events.jsonl
FSM_EVENTS_LOG=/data/observability/fsm_events.jsonl
ENGINE_EVENTS_LOG=/data/observability/engine_events.jsonl
ADMIN_PROOFS_LOG=/data/observability/admin_proofs.jsonl
ERROR_EVENTS_LOG=/data/observability/error_events.jsonl
STRATEGY_AUDITOR_SETTINGS=/data/config/intelligence_settings.json
FREE_LIMIT=6
BASIC_LIMIT=20
PRO_LIMIT=50
ELITE_LIMIT=UNLIMITED
ADMIN_PROOF_CHAT_ID=
ADMIN_PROOF_THREAD_ID=
EVENT_SCHEMA_VERSION=3.0.0
RUN_ID=replace-me
BINARYBOT_ENV_FILE=

# ADMIN UI RESTORATION (optional — add only when needed)
# Owner private DM access: set to the owner's numeric Telegram user ID.
# Must be a plain integer, no quotes, no @username.
# OWNER_TELEGRAM_ID is listed above; ensure it is set correctly.

# Optional topic routing for admin messages (fallback: admin control target)
ADMIN_ALERTS_THREAD_ID=
ADMIN_ERRORS_THREAD_ID=
ADMIN_REPORTS_THREAD_ID=

# File delivery size limit (bytes; default 5242880 = 5 MB)
MAX_DELIVERY_FILE_SIZE=5242880

# DEVELOPMENT/TEST ONLY
PYTHONPATH=send
