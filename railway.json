{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "command": "python -m pip install --upgrade pip && python -m pip install --no-cache-dir -r requirements.txt"
  },
  "deploy": {
    "startCommand": "PYTHONPATH=send python -m scripts.railway_start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "sleepApplication": false
  }
}
