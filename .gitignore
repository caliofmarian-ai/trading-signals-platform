# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
ENV/

# Tool caches
.pytest_cache/
.cache/
.mypy_cache/
.ruff_cache/

# Runtime logs (should not be version-controlled)
*.log
engine.log

# Runtime-owned repository paths
send/observability/*.jsonl
send/outcomes/*.jsonl
send/outcomes/open_now_registry.json
send/outcomes/outcomes_index.json
send/state/*.json
send/analytics/cache/
