send/analytics/reports/daily_strategy_audit_*.md
send/config/.env.example
send/config/*.bak.*

# Temporary decision/patch working files
tmp_decision_*
*.tmp
*.temp
*~

# Development archives
*.zip

# Coverage
.coverage
htmlcov/

# Editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

